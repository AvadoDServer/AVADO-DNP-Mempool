        {
          "var": "backend",
          "ref": "mempool/backend:v{version}"
        },
        {
          "var": "frontend",
          "ref": "mempool/frontend:v{version}"
        }
      ],
      "pins": [
        {
          "file": "build/Dockerfile",
          "text": "ARG MEMPOOL_BACKEND=mempool/backend:v{version}@sha256:{backend}"
